---
/**
 * /contact
 *
 * V4 : la page devient réellement utile. Elle porte un formulaire qui envoie
 * un message à l'IPRIG, là où la V3.1 se contentait de renvoyer vers Patreon
 * faute de back-end.
 *
 * ⚠ AUCUNE ADRESSE E-MAIL N'EST AFFICHÉE. La boîte de destination vit dans la
 * configuration serveur, hors dépôt : elle n'apparaît ni dans cette page, ni
 * dans le JavaScript, ni dans une réponse du serveur. Une adresse publiée en
 * clair sur un site institutionnel est récoltée en quelques jours.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Arrow from '../components/Arrow.astro';
import { offer, contact } from '../data/site';
import { kevanExplique } from '../data/kevan';
---

<BaseLayout
  title="Contact"
  description="Contacter l’IPRIG : une question sur l’accompagnement, le programme, les certificats ou l’adhésion."
  path="/contact"
>
  <PageHeader
    title="Écrire à l’IPRIG"
    lede="Une question sur l’accompagnement, le programme ou l’adhésion ? Voici par où passer"
  />

  {/* ------------------------------------------------------- Formulaire */}
  <section class="section" aria-labelledby="ecrire-title">
    <div class="container container--wide">
      <div class="contact__grid">
        <div class="contact__intro">
          <p class="eyebrow">Poser une question</p>
          <h2 id="ecrire-title" class="contact__title">
            Envoyer un message
          </h2>
          <p class="contact__lede">
            Sur l’accompagnement, le programme, les certificats ou le
            fonctionnement de l’adhésion. Le message arrive directement dans la
            boîte de l’IPRIG.
          </p>
          <p class="contact__note">{contact.responseNote}</p>
        </div>

        <div class="contact__form">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------- Adhérer */}
  <section class="section section--paper-2" aria-labelledby="canaux-title">
    <div class="container container--wide">
      <h2 id="canaux-title" class="sr-only">Autres canaux</h2>

      <ul class="canaux">
        <li class="canal canal--principal">
          <h3 class="canal__label">Rejoindre</h3>

          <div class="canal__body">
            <p class="canal__nom">Patreon</p>
            <p class="canal__texte">
              L’adhésion se fait directement sur Patreon. C’est également là que
              se trouvent les contenus réservés aux membres et les rediffusions
              des séances.
            </p>
            <p class="canal__meta">
              {offer.priceDisplay} {offer.pricePeriod} · {offer.commitment}
            </p>
          </div>

          <a
            class="canal__action"
            href={offer.patreonUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>{offer.ctaPrimary}</span>
            <Arrow />
            <span class="sr-only"> (sur Patreon, nouvelle fenêtre)</span>
          </a>
        </li>

        <li class="canal">
          <h3 class="canal__label">Se préinscrire</h3>

          <div class="canal__body">
            <p class="canal__nom">Certificats de géopolitique</p>
            <p class="canal__texte">
              Dix séances à distance, de février à avril 2027. Les
              préinscriptions se font sur la page dédiée.
            </p>
          </div>

          <a class="canal__action" href="/certificats#preinscription">
            <span>Se préinscrire</span>
            <Arrow />
          </a>
        </li>

        <li class="canal">
          <h3 class="canal__label">Suivre {kevanExplique.name}</h3>

          <div class="canal__body">
            <p class="canal__texte">{kevanExplique.contactLede}</p>
            {/* `showPending` cite en toutes lettres les plateformes dont
                l'adresse n'a pas encore été fournie, plutôt qu'un lien mort.
                Depuis la V4.1, les sept plateformes sont en ligne : il ne
                reste rien à citer et ce bloc ne rend rien. La consigne est
                conservée pour une plateforme future. */}
            <SocialLinks class="canal__socials" showPending />
          </div>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ================================================== Formulaire ====== */
  .contact__grid {
    display: grid;
    gap: var(--space-8);
  }

  .contact__title {
    max-inline-size: 16ch;
    font-size: clamp(1.625rem, 1.25rem + 1.7vw, 2.375rem);
    line-height: 1.08;
  }

  .contact__lede {
    margin-block-start: var(--space-5);
    max-inline-size: var(--measure-wide);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }

  .contact__note {
    margin-block-start: var(--space-5);
    padding-block-start: var(--space-4);
    border-block-start: var(--border-hairline) solid var(--rule);
    max-inline-size: var(--measure);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-muted);
  }

  @media (min-width: 62rem) {
    .contact__grid {
      grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
      gap: var(--space-9);
      align-items: start;
    }
  }

  /* ====================================================== Canaux ====== */
  .canaux {
    border-block-start: var(--border-hairline) solid var(--rule-strong);
  }

  .canal {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-block-end: var(--border-hairline) solid var(--rule);
  }

  .canal__label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent-ink);
  }

  .canal__nom {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--color-navy);
  }

  .canal--principal .canal__nom {
    font-size: 1.75rem;
  }

  .canal__texte {
    margin-block-start: var(--space-3);
    max-inline-size: var(--measure);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }

  .canal__meta {
    margin-block-start: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .canal__socials {
    margin-block-start: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  /* Le lien d'action reprend le geste des liens du site : le filet se trace
     au survol, il n'est pas là en permanence. */
  .canal__action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    align-self: start;
    min-block-size: 2.75rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-navy);
    text-decoration: none;
  }

  .canal__action span:first-child {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 1px;
    padding-block-end: 3px;
    transition: background-size var(--dur) var(--ease-ui);
  }

  .canal__action:hover {
    color: var(--color-forest);
  }

  .canal__action:hover span:first-child {
    background-size: 100% 1px;
  }

  @media (min-width: 48rem) {
    .canal {
      grid-template-columns: minmax(0, 10rem) minmax(0, 1fr) auto;
      gap: var(--space-6);
      align-items: start;
    }

    .canal__action {
      justify-self: end;
    }
  }
</style>
