---
/**
 * /kevan-gafaiti — présentation développée du fondateur.
 *
 * ⚠ TODO CLIENT : validation finale de la biographie et des intitulés
 * académiques avant mise en production. Toutes les informations de cette page
 * proviennent de src/data/kevan.ts et du brief client — rien n’y est ajouté.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import MediaSlot from '../components/MediaSlot.astro';
import CtaPoster from '../components/CtaPoster.astro';
import { kevan, kevanExplique, irig } from '../data/kevan';
import { communitySize, communitySizeLabel, socialsKevanExplique } from '../data/site';

const kevanLinks = socialsKevanExplique.filter((s) => s.url !== null);
---

<BaseLayout
  title="Kevan Gafaïti"
  description="Kevan Gafaïti, fondateur de l’IPRIG : enseignant à Sciences Po Paris, président-fondateur de l’IRIG, chercheur en relations internationales et en géopolitique du Moyen-Orient."
  path="/kevan-gafaiti"
>
  <PageHeader
    eyebrow="Le fondateur"
    title="Kevan Gafaïti"
    lede={kevan.lede}
  />

  <section class="section" aria-labelledby="bio-title">
    <div class="container container--wide">
      <div class="bio__grid">
        <aside class="bio__aside">
          <div class="bio__media">
            {/* TODO CLIENT : portrait professionnel de Kevan Gafaïti. */}
            <MediaSlot
              fallback="founder"
              ratio="tall"
              alt="Kevan Gafaïti"
              caption="Portrait"
              priority
              motionNow
            />
          </div>

          <dl class="bio__facts">
            <div class="fact">
              <dt>Fonctions</dt>
              <dd>
                <ul>
                  {kevan.titles.map((t) => <li>{t}</li>)}
                </ul>
              </dd>
            </div>
            <div class="fact">
              <dt>Enseignement</dt>
              <dd>
                <ul>
                  {kevan.institutions.map((i) => <li>{i}</li>)}
                </ul>
              </dd>
            </div>
            <div class="fact">
              <dt>Domaines de recherche</dt>
              <dd>
                <ul>
                  {kevan.researchAreas.map((r) => <li>{r}</li>)}
                </ul>
              </dd>
            </div>
          </dl>
        </aside>

        <div class="bio__main">
          <h2 id="bio-title" class="bio__title">Parcours</h2>
          <div class="prose bio__prose">
            {kevan.bio.map((p) => <p>{p}</p>)}
          </div>

          {/* ------------------------------------------------- Formation */}
          <h3 class="bio__subtitle">Formation</h3>
          <div class="diplome">
            <p class="diplome__label">{kevan.academic.doctorate.label}</p>
            <p class="diplome__inst">{kevan.academic.doctorate.institution}</p>
            <p class="diplome__subject">
              Thèse : {kevan.academic.doctorate.subject}
            </p>
          </div>

          <div class="diplome">
            <p class="diplome__label">{kevan.academic.masters.label}</p>
            <p class="diplome__inst">
              {kevan.academic.masters.fields.join(' · ')}
            </p>
          </div>
          {
            /* TODO CLIENT : confirmer les intitulés exacts des trois Master 2
               et l’établissement de rattachement de chacun. */
          }

          {/* ------------------------------------------------ Kevan Explique */}
          <h3 class="bio__subtitle">{kevanExplique.name}</h3>
          <div class="prose">
            <p>{kevanExplique.lede}</p>
          </div>

          <div class="explique__meta">
            {
              communitySize && (
                <p class="explique__community">
                  {/* TODO CLIENT : vérifier le nombre actuel avant mise en ligne. */}
                  <strong>{communitySize}</strong>
                  <span>{communitySizeLabel}</span>
                </p>
              )
            }
            {
              /* Voir SectionFondateur.astro : pas de faux liens tant que les
                 URL ne sont pas fournies. */
              kevanLinks.length > 0 ? (
                <ul class="explique__platforms link-list">
                  {kevanLinks.map((s) => (
                    <li>
                      <a
                        class="link"
                        href={s.url!}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {s.label}
                        <span class="sr-only"> (nouvelle fenêtre)</span>
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="explique__platforms-text">
                  Présent sur {kevanExplique.platforms.join(', ')}.
                </p>
              )
            }
          </div>

          {/* --------------------------------------------------------- IRIG */}
          <h3 class="bio__subtitle">{irig.name}</h3>
          <div class="prose">
            <p>
              <strong>{irig.fullName}</strong> — {irig.description}
            </p>
            <p class="irig__note">
              L’IRIG et l’IPRIG sont deux structures distinctes : l’IRIG est un
              centre de recherche, l’IPRIG une structure de préparation et
              d’accompagnement.
            </p>
          </div>
          {
            /* TODO CLIENT : URL du site de l’IRIG lorsqu’il sera en ligne
               (src/data/kevan.ts → irig.url). Un lien sera alors ajouté ici. */
          }
        </div>
      </div>
    </div>
  </section>

  <CtaPoster
    eyebrow="Rejoindre"
    title="Se préparer avec l’IPRIG"
    intro="L’accompagnement proposé par l’IPRIG s’appuie sur cette expérience d’enseignement et de recherche."
  />
</BaseLayout>

<style>
  .bio__grid {
    display: grid;
    gap: var(--space-8);
  }

  .bio__media {
    max-inline-size: 20rem;
  }

  /* ------------------------------------------------------------ Repères */
  .bio__facts {
    display: grid;
    gap: var(--space-5);
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-6);
    border-block-start: var(--border-hairline) solid var(--rule);
  }

  .fact dt {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-muted);
    margin-block-end: var(--space-3);
  }

  .fact dd {
    margin: 0;
  }

  .fact ul {
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-ink-soft);
  }

  .fact li {
    position: relative;
    padding-inline-start: var(--space-5);
  }

  .fact li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.62em;
    inline-size: 10px;
    block-size: 1px;
    background-color: var(--color-accent);
  }

  /* --------------------------------------------------------- Biographie */
  .bio__title {
    font-size: clamp(1.5rem, 1.3rem + 1vw, 2rem);
    margin-block-end: var(--space-5);
  }

  .bio__prose {
    font-size: var(--text-md);
  }

  .bio__subtitle {
    margin-block-start: var(--space-8);
    margin-block-end: var(--space-5);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-hairline) solid var(--rule);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-forest);
  }

  /* ----------------------------------------------------------- Diplômes */
  .diplome + .diplome {
    margin-block-start: var(--space-5);
  }

  .diplome {
    padding-inline-start: var(--space-5);
    border-inline-start: 2px solid var(--color-navy);
  }

  .diplome__label {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    font-weight: 500;
    color: var(--color-navy);
    line-height: 1.3;
  }

  .diplome__inst {
    margin-block-start: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-forest);
    font-weight: 500;
  }

  .diplome__subject {
    margin-block-start: var(--space-3);
    max-inline-size: var(--measure);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }

  /* ---------------------------------------------------- Kevan Explique */
  .explique__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-4) var(--space-7);
    margin-block-start: var(--space-5);
  }

  .explique__community {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .explique__community strong {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--color-forest);
  }

  .explique__platforms {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .explique__platforms-text {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .irig__note {
    max-inline-size: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  @media (min-width: 62rem) {
    .bio__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: var(--space-10);
      align-items: start;
    }

    .bio__media {
      max-inline-size: none;
    }

    .bio__aside {
      position: sticky;
      inset-block-start: calc(var(--header-h) + var(--space-6));
    }
  }

  /* Même seuil que partout ailleurs (voir SectionInstitut, SectionFaq,
     Hero) : sur un écran peu haut, une colonne fixe plus longue que l'écran
     ne se fixe pas, elle bloque. */
  @media (min-width: 62rem) and (max-height: 50rem) {
    .bio__aside {
      position: static;
    }
  }
</style>
