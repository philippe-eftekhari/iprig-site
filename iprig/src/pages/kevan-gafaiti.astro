---
/**
 * /kevan-gafaiti — présentation développée du fondateur.
 *
 * ⚠ TODO CLIENT : validation finale de la biographie et des intitulés
 * académiques avant mise en production. Toutes les informations de cette page
 * proviennent de src/data/kevan.ts et du brief client — rien n'y est ajouté.
 *
 * ⚠ Aucun nombre d'abonnés n'est affiché : voir la note dans src/data/kevan.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import MediaSlot from '../components/MediaSlot.astro';
import SocialLinks from '../components/SocialLinks.astro';
import CtaPoster from '../components/CtaPoster.astro';
import { kevan, kevanExplique, irig } from '../data/kevan';
import portrait from '../assets/kevan/portrait.jpg';
---

<BaseLayout
  title="Kevan Gafaïti"
  description="Kevan Gafaïti, fondateur de l’IPRIG : enseignant à Sciences Po Paris, président-fondateur de l’IRIG, chercheur en relations internationales et en géopolitique du Moyen-Orient."
  path="/kevan-gafaiti"
>
  <PageHeader eyebrow="Le fondateur" title="Kevan Gafaïti" lede={kevan.pageLede} />

  <section class="section" aria-labelledby="bio-title">
    <div class="container container--wide">
      <div class="bio__grid">
        <aside class="bio__aside">
          <div class="bio__media">
            <MediaSlot
              src={portrait}
              ratio="tall"
              alt="Portrait de Kevan Gafaïti, en costume, dans un salon aux boiseries dorées"
              caption="Kevan Gafaïti"
              priority
              motionNow
            />
          </div>

          <dl class="bio__facts">
            <div class="fact">
              <dt>Fonctions</dt>
              <dd>
                <ul>
                  {kevan.titles.map((t) => <li>{t}</li>)}
                </ul>
              </dd>
            </div>
            <div class="fact">
              <dt>Enseignement</dt>
              <dd>
                <ul>
                  {kevan.institutions.map((i) => <li>{i}</li>)}
                </ul>
              </dd>
            </div>
            <div class="fact">
              <dt>Domaines de recherche</dt>
              <dd>
                <ul>
                  {kevan.researchAreas.map((r) => <li>{r}</li>)}
                </ul>
              </dd>
            </div>
          </dl>
        </aside>

        <div class="bio__main">
          <h2 id="bio-title" class="bio__title">Parcours</h2>
          <div class="prose bio__prose justify">
            {kevan.bio.map((p) => <p>{p}</p>)}
          </div>

          {/* --------------------------------------------------- Travaux */}
          <h3 class="bio__subtitle">Travaux</h3>
          <div class="prose justify">
            <p>{kevan.works}</p>
          </div>

          {/* ------------------------------------------------- Formation */}
          <h3 class="bio__subtitle">Formation</h3>
          <div class="diplome">
            <p class="diplome__label">{kevan.academic.doctorate.label}</p>
            <p class="diplome__inst">{kevan.academic.doctorate.institution}</p>
            {/* Le sujet porte déjà ses propres parenthèses (les années) :
                on ne l'enveloppe pas dans une seconde paire. */}
            <p class="diplome__subject">
              Thèse : {kevan.academic.doctorate.subject}
            </p>
          </div>

          <div class="diplome">
            <p class="diplome__label">{kevan.academic.masters.label}</p>
            <p class="diplome__inst">
              {kevan.academic.masters.fields.join(' · ')}
            </p>
          </div>
          {
            /* TODO CLIENT : confirmer les intitulés exacts des trois Master 2
               et l’établissement de rattachement de chacun. */
          }

          {/* -------------------------------------------- KevanExplique */}
          <h3 class="bio__subtitle">{kevanExplique.name}</h3>
          <div class="prose justify">
            <p>{kevanExplique.pageLede}</p>
          </div>
          <SocialLinks class="explique__socials" />

          {/* --------------------------------------------------------- IRIG */}
          <h3 class="bio__subtitle">{irig.heading}</h3>
          <div class="prose justify">
            <p>{irig.description}</p>
          </div>
          {
            /* TODO CLIENT : URL du site de l’IRIG lorsqu’il sera en ligne
               (src/data/kevan.ts → irig.url). Un lien sera alors ajouté ici. */
          }
        </div>
      </div>
    </div>
  </section>

  <CtaPoster
    eyebrow="Rejoindre"
    title="Se préparer avec l’IPRIG"
    intro="L’accompagnement proposé par l’IPRIG s’appuie sur cette expérience d’enseignement et de recherche."
  />
</BaseLayout>

<style>
  .bio__grid {
    display: grid;
    gap: var(--space-8);
  }

  .bio__media {
    max-inline-size: 20rem;
  }

  /* ------------------------------------------------------------ Repères */
  .bio__facts {
    display: grid;
    gap: var(--space-5);
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-6);
    border-block-start: var(--border-hairline) solid var(--rule);
  }

  .fact dt {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-muted);
    margin-block-end: var(--space-3);
  }

  .fact dd {
    margin: 0;
  }

  .fact ul {
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-ink-soft);
  }

  .fact li {
    position: relative;
    padding-inline-start: var(--space-5);
  }

  .fact li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.62em;
    inline-size: 10px;
    block-size: 1px;
    background-color: var(--color-accent);
  }

  /* --------------------------------------------------------- Biographie */
  .bio__title {
    font-size: clamp(1.5rem, 1.3rem + 1vw, 2rem);
    margin-block-end: var(--space-5);
  }

  .bio__prose {
    font-size: var(--text-md);
  }

  .bio__subtitle {
    margin-block-start: var(--space-8);
    margin-block-end: var(--space-5);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-hairline) solid var(--rule);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-forest);
  }

  /* ----------------------------------------------------------- Diplômes */
  .diplome + .diplome {
    margin-block-start: var(--space-5);
  }

  .diplome {
    padding-inline-start: var(--space-5);
    border-inline-start: 2px solid var(--color-navy);
  }

  .diplome__label {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    font-weight: 500;
    color: var(--color-navy);
    line-height: 1.3;
  }

  .diplome__inst {
    margin-block-start: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-forest);
    font-weight: 500;
  }

  .diplome__subject {
    margin-block-start: var(--space-3);
    max-inline-size: var(--measure);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }

  /* ----------------------------------------------------- KevanExplique */
  .explique__socials {
    margin-block-start: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  @media (min-width: 62rem) {
    .bio__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: var(--space-10);
      align-items: start;
    }

    .bio__media {
      max-inline-size: none;
    }

    .bio__aside {
      position: sticky;
      inset-block-start: calc(var(--header-h) + var(--space-6));
    }
  }

  /* Même seuil que partout ailleurs (voir SectionInstitut, SectionFaq,
     Hero) : sur un écran peu haut, une colonne fixe plus longue que l'écran
     ne se fixe pas, elle bloque. */
  @media (min-width: 62rem) and (max-height: 50rem) {
    .bio__aside {
      position: static;
    }
  }
</style>
