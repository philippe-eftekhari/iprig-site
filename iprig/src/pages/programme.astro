---
/**
 * /programme — présentation développée du programme.
 *
 * Reprend les MÊMES composants et les MÊMES données que la page d'accueil :
 * les quatre volets et le programme des séances ne peuvent pas diverger entre
 * les deux pages. L'accueil n'en montre qu'un extrait ; ici, le programme
 * complet, semestre par semestre.
 *
 * ⚠ Les dates du second semestre ne sont pas arrêtées. Elles s'affichent
 * « Date à venir » — ne rien inventer pour remplir la colonne.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SessionsList from '../components/SessionsList.astro';
import Fonctionnement from '../components/Fonctionnement.astro';
import CtaPoster from '../components/CtaPoster.astro';
import MediaSlot from '../components/MediaSlot.astro';
import {
  volets,
  voletsHeading,
  sessionsHeading,
  fonctionnementIntro,
} from '../data/programme';
import orientation from '../assets/kevan/orientation.jpg';
---

<BaseLayout
  title="Programme"
  description="Événements, immersion, sessions et rediffusion : le contenu de l’accompagnement IPRIG et son fonctionnement."
  path="/programme"
>
  <PageHeader
    eyebrow="Programme & expériences"
    title="Ce que comprend l’accompagnement"
    lede={voletsHeading.programmeLede}
  />

  {/* ------------------------------------------------------- Les volets */}
  <section class="section" aria-labelledby="volets-title">
    <div class="container container--wide">
      <h2 id="volets-title" class="sr-only">Les quatre volets</h2>

      <ol class="volets">
        {
          volets.map((v) => (
            <li class="volet">
              <div class="volet__head">
                <span class="volet__numeral" aria-hidden="true">
                  {v.numeral}
                </span>
                <h3 class="volet__title">{v.title}</h3>
              </div>
              <div class="volet__content">
                <p class="volet__lede">{v.lede}</p>
                <ul class="volet__points">
                  {v.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ------------------------------------------------------ Les séances */}
  <section class="section section--lg section--paper-2" aria-labelledby="seances-title">
    <div class="container container--wide">
      <div class="seances__grid">
        <div class="seances__head">
          <p class="eyebrow">{sessionsHeading.programmeEyebrow}</p>
          <h2 id="seances-title" class="seances__title">
            {sessionsHeading.programmeTitle}
          </h2>
          <p class="lede seances__lede">{sessionsHeading.programmeLede}</p>

          <div class="seances__media">
            <MediaSlot
              src={orientation}
              ratio="landscape"
              alt="Kevan Gafaïti devant une salle d’étudiants, présentant un programme sur les études en diplomatie"
              caption="Intervention sur les études en diplomatie"
            />
          </div>
        </div>

        <div class="seances__list">
          <SessionsList />
        </div>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------- Fonctionnement */}
  <section class="section" aria-labelledby="fonctionnement-title">
    <div class="container container--wide">
      <h2 id="fonctionnement-title" class="fonctionnement-title">
        Rejoindre, en pratique
      </h2>
      <Fonctionnement intro={fonctionnementIntro} />
      {/* Le rappel « ni diplôme ni certification » n'est pas répété ici :
          la FAQ de la page d'accueil le dit déjà, et la page /certificats
          porte son propre avertissement, plus précis. Le répéter trois fois
          l'affaiblirait. */}
    </div>
  </section>

  <CtaPoster
    eyebrow="Rejoindre"
    title="Une seule formule"
    intro="Aucune durée minimale : l’accès à l’ensemble du programme, aux événements et aux rediffusions est immédiat."
  />
</BaseLayout>

<style>
  /* ------------------------------------------------------------ Volets */
  .volets {
    display: grid;
    gap: 0;
    border-block-start: var(--border-hairline) solid var(--rule);
  }

  .volet {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-7);
    border-block-end: var(--border-hairline) solid var(--rule);
  }

  .volet__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }

  /* V4 — chiffre arabe au lieu du chiffre romain, conformément à la
     numérotation retenue pour tout le site. Même traitement typographique,
     colonne resserrée puisqu'un chiffre occupe moins de place que « III ». */
  .volet__numeral {
    font-family: var(--font-serif);
    font-size: 1rem;
    letter-spacing: 0.12em;
    color: var(--color-accent-ink);
    flex: none;
    inline-size: 1.25rem;
  }

  .volet__title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.125rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-navy);
  }

  .volet__lede {
    max-inline-size: 54ch;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--color-ink-soft);
  }

  .volet__points {
    display: grid;
    gap: var(--space-2);
    margin-block-start: var(--space-5);
    font-size: var(--text-sm);
  }

  .volet__points li {
    position: relative;
    padding-inline-start: var(--space-5);
    line-height: 1.45;
    color: var(--color-ink-soft);
  }

  .volet__points li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.62em;
    inline-size: 10px;
    block-size: 1px;
    background-color: var(--color-forest);
  }

  /* ----------------------------------------------------------- Séances */
  .seances__grid {
    display: grid;
    gap: var(--space-8);
  }

  .seances__title {
    max-inline-size: 18ch;
  }

  .seances__lede {
    margin-block-start: var(--space-4);
  }

  .seances__media {
    margin-block-start: var(--space-7);
  }

  /* ---------------------------------------------------- Fonctionnement */
  .fonctionnement-title {
    max-inline-size: 18ch;
    margin-block-end: var(--space-7);
  }

  @media (min-width: 48rem) {
    .volet {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-7);
      align-items: start;
    }
  }

  @media (min-width: 62rem) {
    .volet {
      padding-block: var(--space-8);
    }

    .seances__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: var(--space-9);
      align-items: start;
    }
  }
</style>
