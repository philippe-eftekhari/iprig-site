---
/**
 * /certificats — les certificats semestriels de géopolitique.
 *
 * Tout le contenu vient de `src/data/certificats.ts` : catalogue, enseignants,
 * modalités, tarifs, validation. Le formulaire de préinscription lit la même
 * source, la validation serveur aussi.
 *
 * ⚠ V4 : PRÉINSCRIPTION UNIQUEMENT.
 * Aucun paiement n'est possible sur ce site. Pas de panier, pas de Stripe,
 * pas de bouton « Acheter ». Les tarifs sont affichés à titre d'information.
 *
 * ⚠ Les seules modalités d'examen validées tiennent en deux mots : examen
 * terminal. Ne rien ajouter — ni format, ni durée, ni note minimale, ni
 * coefficient, ni rattrapage.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import TeacherCard from '../components/TeacherCard.astro';
import PreinscriptionForm from '../components/PreinscriptionForm.astro';
import Arrow from '../components/Arrow.astro';
import {
  certificatsPage,
  certificatsPurpose,
  certificatsCta,
  teachers,
  teachersHeading,
  certificates,
  certificatesOf,
  modalites,
  modalitesNote,
  tarifs,
  tarifsNote,
  validation,
  preinscription,
} from '../data/certificats';

/** Seuls les enseignants qui portent au moins un certificat sont affichés. */
const enseignants = teachers
  .map((t) => ({ teacher: t, certificates: certificatesOf(t.id) }))
  .filter((e) => e.certificates.length > 0);
---

<BaseLayout
  title="Certificats de géopolitique"
  description="Certificats semestriels d’introduction à la géopolitique de l’IPRIG : dix séances à distance à partir de février 2027, régions du monde et grandes thématiques des relations internationales. Préinscriptions ouvertes."
  path="/certificats"
>
  <PageHeader
    eyebrow={certificatsPage.eyebrow}
    title={certificatsPage.title}
    lede={certificatsPage.tagline}
  />

  {/* ------------------------------------------------------- Présentation */}
  <section class="section" aria-labelledby="presentation-title">
    <div class="container container--wide">
      <div class="cert-intro">
        <h2 id="presentation-title" class="sr-only">
          Présentation des certificats
        </h2>
        <p class="cert-intro__lede justify">{certificatsPage.intro}</p>

        <div class="cert-intro__purpose">
          <h3 class="cert-intro__purpose-title">{certificatsPurpose.title}</h3>
          <p class="justify">{certificatsPurpose.body}</p>
        </div>
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------- Modalités */}
  <section
    class="section section--paper-2"
    aria-labelledby="modalites-title"
    id="modalites"
  >
    <div class="container container--wide">
      <p class="eyebrow">En pratique</p>
      <h2 id="modalites-title" class="section-title">
        Comment se déroule un certificat
      </h2>

      <dl class="modalites">
        {
          modalites.map((m) => (
            <div class="modalite">
              <dt class="modalite__label">{m.label}</dt>
              <dd class="modalite__detail">{m.detail}</dd>
            </div>
          ))
        }
      </dl>

      <p class="modalites__note">{modalitesNote}</p>
    </div>
  </section>

  {/* ------------------------------------------------------- Enseignants */}
  <section class="section section--lg" aria-labelledby="enseignants-title">
    <div class="container container--wide">
      <div class="teachers__head">
        <h2 id="enseignants-title" class="section-title" data-motion="title">
          <span class="motion-inner">{teachersHeading.title}</span>
        </h2>
        <p class="teachers__lede justify">{teachersHeading.body}</p>
      </div>

      <div class="teachers__list">
        {
          enseignants.map((e) => (
            <TeacherCard teacher={e.teacher} certificates={e.certificates} />
          ))
        }
      </div>

      <p class="teachers__count">
        {certificates.length} certificats au catalogue pour la session de février
        à avril 2027
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------ Tarifs */}
  <section
    class="section section--paper-2"
    aria-labelledby="tarifs-title"
    id="tarifs"
  >
    <div class="container container--wide">
      <p class="eyebrow">Tarifs</p>
      <h2 id="tarifs-title" class="section-title">
        Un tarif dégressif selon le nombre de certificats
      </h2>

      <ul class="tarifs">
        {
          tarifs.map((t) => (
            <li class="tarif">
              <span class="tarif__count">{t.label}</span>
              <span class="tarif__price">{t.price}</span>
            </li>
          ))
        }
      </ul>

      <p class="tarifs__note justify">{tarifsNote}</p>

      {/* ⚠ Aucun bouton d'achat ici, et il ne doit jamais y en avoir en V4. */}
      <p class="tarifs__paiement">
        Aucun paiement n’est effectué sur ce site. Les modalités de règlement
        seront communiquées aux personnes préinscrites.
      </p>
    </div>
  </section>

  {/* -------------------------------------------------------- Validation */}
  <section class="section" aria-labelledby="validation-title">
    <div class="container container--wide">
      <div class="validation">
        <h2 id="validation-title" class="section-title">{validation.title}</h2>
        <p class="validation__body justify">{validation.body}</p>
        <p class="disclaimer">{validation.disclaimer}</p>
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------- Préinscription */}
  <section
    class="section section--lg section--paper-2"
    aria-labelledby="preinscription-title"
    id="preinscription"
  >
    <div class="container container--wide">
      <div class="preinscription">
        <div class="preinscription__intro">
          <p class="eyebrow">Préinscription</p>
          <h2 id="preinscription-title" class="section-title" data-motion="title">
            <span class="motion-inner">{preinscription.title}</span>
          </h2>
          <p class="preinscription__lede">{preinscription.body}</p>
        </div>

        <div class="preinscription__form">
          <PreinscriptionForm />
        </div>
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------- Clôture */}
  <section class="cert-cta section--dark">
    <div class="container container--wide">
      <p class="cert-cta__label">Certificats</p>
      <h2 class="cert-cta__title" data-motion="title">
        <span class="motion-inner">{certificatsCta.title}</span>
      </h2>
      <span class="cert-cta__rule" aria-hidden="true" data-motion="rule"></span>
      <div class="cert-cta__foot">
        <p class="cert-cta__intro">
          Dix séances à distance, de février à avril 2027. Les préinscriptions
          sont ouvertes.
        </p>
        <a class="btn btn--on-dark btn--lg" href="#preinscription">
          {certificatsCta.cta}
          <Arrow />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Titre de section réutilisé dans toute la page — même échelle que les
     titres de la page d'accueil, pour que /certificats ne se lise pas comme
     une pièce rapportée. */
  .section-title {
    max-inline-size: 22ch;
    font-size: clamp(1.625rem, 1.25rem + 1.7vw, 2.375rem);
    line-height: 1.08;
  }

  /* ================================================== Présentation ==== */
  .cert-intro {
    display: grid;
    gap: var(--space-7);
  }

  .cert-intro__lede {
    max-inline-size: 58ch;
    font-family: var(--font-serif);
    font-size: var(--text-lede);
    line-height: var(--leading-normal);
    color: var(--color-ink);
  }

  .cert-intro__purpose {
    max-inline-size: var(--measure-wide);
    padding-block-start: var(--space-6);
    border-block-start: var(--border-hairline) solid var(--rule);
    color: var(--color-ink-soft);
  }

  .cert-intro__purpose-title {
    margin-block-end: var(--space-4);
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--color-navy);
  }

  @media (min-width: 62rem) {
    .cert-intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-9);
      align-items: start;
    }

    .cert-intro__purpose {
      padding-block-start: 0;
      padding-inline-start: var(--space-8);
      border-block-start: 0;
      border-inline-start: var(--border-hairline) solid var(--rule);
    }
  }

  /* ==================================================== Modalités ===== */
  .modalites {
    display: grid;
    gap: 0;
    margin-block-start: var(--space-7);
    border-block-start: var(--border-hairline) solid var(--rule);
  }

  .modalite {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-block-end: var(--border-hairline) solid var(--rule);
  }

  .modalite__label {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--color-navy);
  }

  .modalite__detail {
    max-inline-size: var(--measure);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }

  .modalites__note {
    max-inline-size: var(--measure-wide);
    margin-block-start: var(--space-6);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-muted);
  }

  @media (min-width: 48rem) {
    .modalite {
      grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
      gap: var(--space-6);
      align-items: baseline;
    }
  }

  /* =================================================== Enseignants ==== */
  .teachers__head {
    max-inline-size: 46rem;
    margin-block-end: var(--space-7);
  }

  .teachers__lede {
    margin-block-start: var(--space-5);
    max-inline-size: var(--measure-wide);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }

  .teachers__list {
    border-block-start: var(--border-hairline) solid var(--rule);
  }

  .teachers__count {
    margin-block-start: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* ======================================================= Tarifs ===== */
  .tarifs {
    display: grid;
    margin-block-start: var(--space-7);
    border-block-start: var(--border-hairline) solid var(--rule-strong);
  }

  .tarif {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-4);
    border-block-end: var(--border-hairline) solid var(--rule);
  }

  .tarif__count {
    font-size: var(--text-md);
    color: var(--color-ink-soft);
  }

  .tarif__price {
    font-family: var(--font-serif);
    font-size: 1.625rem;
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--color-navy);
  }

  .tarifs__note {
    max-inline-size: var(--measure-wide);
    margin-block-start: var(--space-6);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }

  .tarifs__paiement {
    max-inline-size: var(--measure-wide);
    margin-block-start: var(--space-4);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-muted);
  }

  @media (min-width: 48rem) {
    .tarifs {
      max-inline-size: 34rem;
    }
  }

  /* =================================================== Validation ===== */
  .validation {
    max-inline-size: var(--measure-wide);
  }

  .validation__body {
    margin-block-start: var(--space-5);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }

  /* Avertissement légal : sobre mais impossible à manquer. */
  .disclaimer {
    margin-block-start: var(--space-6);
    padding-inline-start: var(--space-5);
    border-inline-start: 2px solid var(--color-accent);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }

  /* ================================================ Préinscription ==== */
  .preinscription {
    display: grid;
    gap: var(--space-8);
  }

  .preinscription__lede {
    margin-block-start: var(--space-5);
    max-inline-size: var(--measure-wide);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }

  @media (min-width: 62rem) {
    .preinscription {
      grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
      gap: var(--space-9);
      align-items: start;
    }
  }

  /* ====================================================== Clôture ===== */
  .cert-cta {
    padding-block: var(--section-y-lg);
  }

  .cert-cta__label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent-bright);
  }

  .cert-cta__title {
    max-inline-size: 18ch;
    margin-block-start: var(--space-5);
    font-size: clamp(2rem, 1.4rem + 2.8vw, 3.5rem);
    line-height: 1.02;
    color: var(--color-on-dark);
  }

  .cert-cta__rule {
    display: block;
    block-size: 1px;
    inline-size: 100%;
    margin-block: var(--space-7);
    background-color: var(--rule-on-dark);
  }

  .cert-cta__foot {
    display: grid;
    gap: var(--space-6);
  }

  .cert-cta__intro {
    max-inline-size: var(--measure);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-on-dark-muted);
  }

  @media (min-width: 62rem) {
    .cert-cta__foot {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-9);
      align-items: center;
    }
  }
</style>
