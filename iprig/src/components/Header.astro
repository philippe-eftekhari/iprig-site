---
/**
 * En-tête du site : wordmark, navigation, CTA Patreon et menu mobile.
 *
 * Comportements :
 *  — indicateur de progression de lecture (CSS scroll-driven, JS en repli) ;
 *  — état « défilé » détecté par IntersectionObserver, sans écouteur de scroll ;
 *  — tiroir mobile accessible : Échap, piège de focus, `aria-expanded`,
 *    verrouillage du défilement, restitution du focus à la fermeture.
 */
import Wordmark from './Wordmark.astro';
import { mainNav } from '../data/navigation';
import { offer } from '../data/site';

interface Props {
  /** Chemin canonique de la page, transmis par BaseLayout. */
  path: string;
}

const { path } = Astro.props;

/**
 * Page courante — résolue au build, sans une ligne de JavaScript.
 *
 * On lit le `path` que BaseLayout utilise déjà pour le lien canonique plutôt
 * que `Astro.url` : une seule source de vérité pour « quelle page est-ce », et
 * elle ne dépend ni du format de sortie ni de la barre oblique finale.
 *
 * Seules les entrées qui pointent vers une PAGE peuvent être « courantes ».
 * Les ancres (`/#institut`, `/#faq`) ne le sont jamais : sur la page
 * d'accueil, c'est l'indicateur de progression qui dit où l'on se trouve, et
 * allumer un lien d'ancre au chargement dirait quelque chose de faux.
 */
const here = path.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  !href.includes('#') && href !== '/' && here === href.replace(/\/$/, '');
---

{/* Sentinelle : sa sortie du viewport déclenche l’état « défilé ». */}
<div id="header-sentinel" aria-hidden="true"></div>

<header class="header" id="site-header" data-header>
  <div class="header__progress" aria-hidden="true">
    <span class="header__progress-bar"></span>
  </div>

  <div class="header__inner container container--wide">
    <a href="/" class="header__brand" aria-label="IPRIG — retour à l’accueil">
      <Wordmark size="md" />
    </a>

    <nav class="header__nav" aria-label="Navigation principale">
      <ul class="header__list">
        {
          mainNav.map((item) => (
            <li>
              <a
                class="header__link"
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a
        class="btn header__cta"
        href={offer.patreonUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        {offer.ctaPrimary}
        <span class="sr-only"> (sur Patreon, nouvelle fenêtre)</span>
      </a>

      <button
        type="button"
        class="header__toggle"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="header__toggle-bars" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
        <span class="sr-only">Ouvrir le menu</span>
      </button>
    </div>
  </div>
</header>

{/* ---------------------------------------------------------------- Tiroir */}
<div class="drawer" id="mobile-menu" hidden>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="drawer__head container">
      <Wordmark size="md" tone="light" />
      <button type="button" class="drawer__close" id="menu-close">
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M4 4l12 12M16 4L4 16"
            stroke="currentColor"
            stroke-width="1.4"
          ></path>
        </svg>
        <span class="sr-only">Fermer le menu</span>
      </button>
    </div>

    <nav class="drawer__nav container" aria-label="Navigation">
      <ul class="drawer__list">
        {
          mainNav.map((item, i) => (
            <li class="drawer__item">
              <a
                class="drawer__link"
                href={item.href}
                data-drawer-link
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                <span class="drawer__index">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="drawer__label">
                  {item.label}
                  {item.description && (
                    <span class="drawer__desc">{item.description}</span>
                  )}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="drawer__foot container">
      <a
        class="btn btn--on-dark btn--lg drawer__cta"
        href={offer.patreonUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        {offer.ctaPrimary}
        <span class="sr-only"> (sur Patreon, nouvelle fenêtre)</span>
      </a>
      <p class="drawer__price">
        {offer.priceDisplay} {offer.pricePeriod} · {offer.commitment}
      </p>
    </div>
  </div>
</div>

<style>
  /* --------------------------------------------------------------- En-tête */
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    /* Fond opaque plutôt qu'un `backdrop-filter` : une bande floutée en
       position sticky impose un recalcul de composition à chaque frame de
       défilement, pour un gain visuel nul sur un fond papier presque opaque. */
    background-color: var(--color-paper);
    border-block-end: var(--border-hairline) solid transparent;
    transition: border-color var(--dur) var(--ease-ui);
  }

  .header.is-scrolled {
    border-block-end-color: var(--rule);
  }

  #header-sentinel {
    position: absolute;
    inset-block-start: 0;
    block-size: 1px;
    inline-size: 100%;
    pointer-events: none;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    block-size: var(--header-h);
  }

  .header__brand {
    text-decoration: none;
    flex: none;
  }

  /* ------------------------------------------- Indicateur de progression */
  .header__progress {
    position: absolute;
    inset-block-end: -1px;
    inset-inline: 0;
    block-size: 2px;
    overflow: hidden;
    pointer-events: none;
  }

  .header__progress-bar {
    display: block;
    block-size: 100%;
    inline-size: 100%;
    transform-origin: 0 50%;
    /* État de repos ; le script ci-dessous écrit la transformation
       directement sur cet élément si le navigateur ne sait pas animer au
       scroll en CSS. */
    transform: scaleX(0);
    /* Un repère de lecture, pas une barre de chargement : une seule couleur,
       l'accent laiton de la marque. Le dégradé de la V1 évoquait une
       progression d'application. */
    background-color: var(--color-accent);
  }

  /* Navigateurs modernes : animation pilotée par le scroll, sans JS. */
  @supports (animation-timeline: scroll()) {
    .header__progress-bar {
      animation-name: progress-grow;
      animation-timing-function: linear;
      animation-fill-mode: both;
    }

    /* Sélecteur volontairement plus spécifique : il empêche le minifieur CSS
       de replier `animation-timeline` dans le raccourci `animation`. Chrome
       n'accepte pas la timeline dans le raccourci et ignorerait alors toute
       la déclaration — la barre resterait figée à zéro. */
    .header .header__progress-bar {
      animation-timeline: scroll(root block);
      animation-duration: auto;
    }
  }

  @keyframes progress-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* ------------------------------------------------------ Navigation desktop */
  .header__nav {
    display: none;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-4), 2.2vw, var(--space-7));
  }

  .header__link {
    display: inline-block;
    padding-block: var(--space-2);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-ink-soft);
    text-decoration: none;
    position: relative;
    transition: color var(--dur-fast) var(--ease-ui);
  }

  .header__link::after {
    content: '';
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 0;
    inline-size: 100%;
    block-size: 1px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--dur) var(--ease-ui);
  }

  .header__link:hover {
    color: var(--color-navy);
  }

  .header__link:hover::after {
    transform: scaleX(1);
  }

  /* Page courante — pas de pilule, pas de fond : le filet laiton du survol,
     simplement déjà tracé. Le repère et l'affordance parlent le même
     langage, ce qui évite d'inventer un troisième signal. */
  .header__link[aria-current='page'] {
    color: var(--color-navy);
  }

  .header__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex: none;
  }

  .header__cta {
    display: none;
  }

  /* ------------------------------------------------------------ Hamburger */
  .header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    margin-inline-end: calc(var(--space-3) * -1);
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--color-navy);
  }

  .header__toggle-bars {
    display: grid;
    gap: 5px;
    inline-size: 22px;
  }

  .header__toggle-bars span {
    display: block;
    block-size: 1.5px;
    background-color: currentColor;
    transition: transform var(--dur) var(--ease-ui),
      opacity var(--dur-fast) var(--ease-ui);
  }

  /* La 3ᵉ barre est plus courte : détail qui évite le hamburger générique. */
  .header__toggle-bars span:last-child {
    inline-size: 60%;
    margin-inline-start: auto;
  }

  .header__toggle[aria-expanded='true'] .header__toggle-bars span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .header__toggle[aria-expanded='true'] .header__toggle-bars span:nth-child(2) {
    opacity: 0;
  }

  .header__toggle[aria-expanded='true'] .header__toggle-bars span:nth-child(3) {
    inline-size: 100%;
    transform: translateY(-6.5px) rotate(-45deg);
  }

  @media (min-width: 30rem) {
    .header__cta {
      display: inline-flex;
      padding-inline: var(--space-5);
      font-size: var(--text-xs);
    }
  }

  @media (min-width: 62rem) {
    .header__nav {
      display: block;
      margin-inline-start: auto;
    }

    .header__toggle {
      display: none;
    }

    .header__cta {
      padding-inline: var(--space-6);
      font-size: var(--text-sm);
    }
  }

  /* --------------------------------------------------------------- Tiroir */
  .drawer {
    position: fixed;
    inset: 0;
    z-index: 150;
  }

  .drawer[hidden] {
    display: none;
  }

  .drawer__panel {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    background-color: var(--color-navy-deep);
    color: var(--color-on-dark);
    overflow-y: auto;
    overscroll-behavior: contain;
    animation: drawer-in var(--dur) var(--ease-ui) both;
  }

  @keyframes drawer-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    block-size: var(--header-h);
    flex: none;
    border-block-end: var(--border-hairline) solid var(--rule-on-dark);
  }

  .drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    margin-inline-end: calc(var(--space-3) * -1);
    background: none;
    border: 0;
    color: var(--color-on-dark);
    cursor: pointer;
  }

  .drawer__nav {
    flex: 1;
    padding-block: var(--space-5);
  }

  .drawer__item {
    border-block-end: var(--border-hairline) solid var(--rule-on-dark);
  }

  .drawer__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-4);
    min-block-size: 3rem;
    text-decoration: none;
    color: var(--color-on-dark);
    transition: color var(--dur-fast) var(--ease-ui);
  }

  .drawer__link:hover,
  .drawer__link[aria-current='page'] {
    color: var(--color-accent-bright);
  }

  .drawer__index {
    font-family: var(--font-serif);
    font-size: 0.75rem;
    color: var(--color-accent-bright);
    letter-spacing: 0.1em;
    flex: none;
    inline-size: 1.5rem;
  }

  .drawer__label {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: var(--tracking-tight);
  }

  .drawer__desc {
    display: block;
    margin-block-start: var(--space-1);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--color-on-dark-muted);
    letter-spacing: 0;
  }

  .drawer__foot {
    flex: none;
    padding-block: var(--space-6) var(--space-8);
    border-block-start: var(--border-hairline) solid var(--rule-on-dark);
  }

  .drawer__cta {
    inline-size: 100%;
  }

  .drawer__price {
    margin-block-start: var(--space-3);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-on-dark-muted);
  }

  @media (min-width: 62rem) {
    .drawer {
      display: none;
    }
  }
</style>

<script>
  /* ------------------------------------------------- État « défilé » */
  const header = document.querySelector<HTMLElement>('[data-header]');
  const sentinel = document.getElementById('header-sentinel');

  if (header && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([entry]) => header.classList.toggle('is-scrolled', !entry!.isIntersecting),
      { threshold: 0 },
    ).observe(sentinel);
  }

  /* ------------------- Progression de lecture — repli pour navigateurs
     sans scroll-driven animations (la version CSS ne coûte rien).

     Deux précautions de performance :
      — on écrit la transformation directement sur la barre, et non dans une
        variable CSS portée par :root, qui invaliderait le style de tout
        l'arbre à chaque frame ;
      — la hauteur totale du document est mise en cache et recalculée
        seulement au redimensionnement, pour ne pas forcer un calcul de mise
        en page à chaque frame. */
  const bar = document.querySelector<HTMLElement>('.header__progress-bar');

  if (bar && !CSS.supports('animation-timeline: scroll()')) {
    let max = 0;
    let ticking = false;

    const measure = () => {
      const doc = document.documentElement;
      max = doc.scrollHeight - doc.clientHeight;
    };

    const paint = () => {
      const ratio = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
      bar.style.transform = `scaleX(${ratio})`;
      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(paint);
    };

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', () => {
      measure();
      onScroll();
    });

    measure();
    paint();
  }

  /* ------------------------------------------------------ Menu mobile */
  const toggle = document.getElementById('menu-toggle');
  const closeBtn = document.getElementById('menu-close');
  const drawer = document.getElementById('mobile-menu');

  if (toggle && closeBtn && drawer) {
    const FOCUSABLE = 'a[href], button:not([disabled])';
    let lastFocused: HTMLElement | null = null;

    /* Le reste de la page est neutralisé pendant que le tiroir est ouvert :
       `aria-modal` suffit à la plupart des lecteurs d'écran, `inert` garantit
       en plus qu'aucun élément d'arrière-plan ne reste atteignable. */
    const background = () =>
      document.querySelectorAll<HTMLElement>('#site-header, main, footer');

    const openDrawer = () => {
      lastFocused = document.activeElement as HTMLElement;
      drawer.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      toggle.querySelector('.sr-only')!.textContent = 'Fermer le menu';
      document.body.style.overflow = 'hidden';
      background().forEach((el) => el.setAttribute('inert', ''));
      closeBtn.focus();
    };

    const closeDrawer = () => {
      drawer.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.querySelector('.sr-only')!.textContent = 'Ouvrir le menu';
      document.body.style.overflow = '';
      // `inert` doit être retiré avant de rendre le focus au bouton.
      background().forEach((el) => el.removeAttribute('inert'));
      (lastFocused ?? toggle).focus();
    };

    toggle.addEventListener('click', () =>
      drawer.hidden ? openDrawer() : closeDrawer(),
    );
    closeBtn.addEventListener('click', closeDrawer);

    // Une ancre ferme le tiroir avant de laisser le navigateur défiler.
    drawer
      .querySelectorAll<HTMLAnchorElement>('[data-drawer-link]')
      .forEach((link) => link.addEventListener('click', closeDrawer));

    document.addEventListener('keydown', (event) => {
      if (drawer.hidden) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        closeDrawer();
        return;
      }

      if (event.key !== 'Tab') return;

      // Piège de focus : le focus ne sort jamais du tiroir ouvert.
      const items = Array.from(drawer.querySelectorAll<HTMLElement>(FOCUSABLE));
      if (items.length === 0) return;

      const first = items[0]!;
      const last = items[items.length - 1]!;
      const active = document.activeElement;

      if (event.shiftKey && active === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // Le tiroir n’existe qu’en dessous de 62rem : on le ferme si l’on repasse
    // en navigation desktop, pour ne pas laisser le body verrouillé.
    const desktop = matchMedia('(min-width: 62rem)');
    desktop.addEventListener('change', (e) => {
      if (e.matches && !drawer.hidden) closeDrawer();
    });
  }
</script>
