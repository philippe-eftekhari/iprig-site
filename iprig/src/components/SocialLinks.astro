---
/**
 * ============================================================================
 *  Liens sociaux — affichage unique pour tout le site
 * ============================================================================
 *  La liste vient de `socialLinks` (src/data/site.ts) : accueil, page Kevan
 *  Gafaïti, page contact et pied de page affichent donc exactement les mêmes
 *  comptes. Une URL corrigée dans le fichier de données l'est partout.
 *
 *  Une plateforme dont l'URL vaut `null` n'est JAMAIS rendue comme un lien.
 *  Elle apparaît, si `showPending` est activé, comme une simple mention
 *  textuelle : un lien mort coûte plus cher qu'une plateforme absente.
 *
 *  Les glyphes sont dessinés en `currentColor` : ils prennent la couleur du
 *  texte environnant et fonctionnent donc aussi bien sur papier que sur fond
 *  marine, sans variante à maintenir.
 * ============================================================================
 */
import { activeSocialLinks, pendingSocialLinks, type SocialId } from '../data/site';

interface Props {
  /** `labels` : icône + nom. `icons` : icône seule, nom réservé aux lecteurs d'écran. */
  variant?: 'labels' | 'icons';
  /** Afficher la mention des plateformes dont l'URL n'est pas encore fournie. */
  showPending?: boolean;
  class?: string;
}

const { variant = 'labels', showPending = false, class: className = '' } = Astro.props;

/**
 * Chemins des glyphes, sur une grille 24 × 24.
