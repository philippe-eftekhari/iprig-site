---

{
  activeSocialLinks.length > 0 && (
    <ul class={`socials socials--${variant} ${className}`}>
      {activeSocialLinks.map((s) => (
        <li>
          <a
            class="socials__link"
            href={s.url!}
            target="_blank"
            rel="noopener noreferrer"
          >
            {ICONS[s.id] ? (
              <svg
                class="socials__icon"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                aria-hidden="true"
                focusable="false"
              >
                <path d={ICONS[s.id]} fill="currentColor" />
              </svg>
            ) : (
              <span class="socials__dot" aria-hidden="true" />
            )}

            {variant === 'labels' ? (
              <span class="socials__label">{s.label}</span>
            ) : (
              <span class="sr-only">{s.label}</span>
            )}
            <span class="sr-only"> (nouvelle fenêtre)</span>
          </a>
        </li>
      ))}
    </ul>
  )
}

{
  /* Plateformes annoncées dont l'adresse n'a pas encore été communiquée.
     Mention textuelle, jamais un lien : `href="#"` est proscrit. */
  showPending && pendingSocialLinks.length > 0 && (
    <p class="socials__pending">
      {pendingSocialLinks.map((s) => s.label).join(', ')}
      <span class="socials__pending-note"> — lien à venir</span>
    </p>
  )
}

<style>
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .socials--icons {
    gap: var(--space-2);
  }

  .socials__link {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    /* Cible tactile : 44 px de haut même quand le glyphe n'en fait que 18. */
    min-block-size: 2.75rem;
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-ui);
  }

  .socials--icons .socials__link {
    justify-content: center;
    inline-size: 2.75rem;
  }

  .socials__icon {
    flex: none;
    opacity: 0.7;
    transition: opacity var(--dur-fast) var(--ease-ui);
  }

  .socials__dot {
    inline-size: 6px;
    block-size: 6px;
    flex: none;
    background-color: currentColor;
    transform: rotate(45deg);
    opacity: 0.6;
  }

  /* Le filet sous le libellé reprend le geste des liens du site : il se trace
     au survol, il n'apparaît pas d'un coup. */
  .socials__label {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 1px;
    padding-block-end: 2px;
    transition: background-size var(--dur) var(--ease-ui);
  }

  .socials__link:hover {
    color: var(--color-forest);
  }

  .socials__link:hover .socials__icon {
    opacity: 1;
  }

  .socials__link:hover .socials__label {
    background-size: 100% 1px;
  }

  .section--dark .socials__link:hover,
  .section--forest .socials__link:hover,
  .footer .socials__link:hover {
    color: var(--color-accent-bright);
  }

  .socials__pending {
    margin-block-start: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .socials__pending-note {
    font-style: italic;
  }

  .section--dark .socials__pending,
  .footer .socials__pending {
    color: var(--color-on-dark-muted);
  }
</style>
