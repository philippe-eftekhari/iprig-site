---
/**
 * « L'institut » — présentation de la prépa et raisons de la rejoindre,
 * traitées comme une seule rubrique éditoriale.
 *
 * Composition : manifeste à gauche (colonne fixe), index numéroté à droite.
 * C'est un sommaire de revue, pas une grille de cartes.
 *
 * V2 :
 *   — numéros nettement plus grands, suspendus dans la marge ;
 *   — l'encart « à qui s'adresse » perd son fond et son cadre : il devient
 *     une liste sous filet, comme une note de bas de colonne ;
 *   — un seul geste de motion : le titre du manifeste.
 */
import { institut, publics, apports } from '../data/institut';
---

<section class="institut section section--lg section--paper-2" id="institut">
  <div class="container container--wide">
    <div class="institut__grid">
      <div class="institut__intro">
        <p class="eyebrow">{institut.eyebrow}</p>

        <h2 class="institut__title" data-motion="title">
          <span class="motion-inner">{institut.title}</span>
        </h2>

        <p class="institut__lede">{institut.lede}</p>

        <div class="institut__body">
          {institut.body.map((p) => <p>{p}</p>)}
        </div>

        <div class="institut__publics">
          <h3 class="institut__publics-title">À qui s’adresse l’institut</h3>
          <ul class="institut__publics-list">
            {publics.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </div>

      <div class="institut__index">
        <h3 class="sr-only">Ce que l’IPRIG apporte</h3>
        <ol class="apports">
          {
            apports.map((a) => (
              <li class="apport">
                <span class="apport__index" aria-hidden="true">
                  {a.index}
                </span>
                <div class="apport__body">
                  <h4 class="apport__title">{a.title}</h4>
                  <p class="apport__text">{a.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .institut__grid {
    display: grid;
    gap: var(--space-9);
  }

  .institut__title {
    max-inline-size: 15ch;
    font-size: clamp(1.875rem, 1.3rem + 2.4vw, 3rem);
    line-height: 1.04;
  }

  /* Le chapô du manifeste est le texte le plus grand de la colonne :
     il porte l'argument, le reste l'explique. */
  .institut__lede {
    margin-block-start: var(--space-5);
    max-inline-size: 34ch;
    font-family: var(--font-serif);
    font-size: var(--text-lede);
    line-height: var(--leading-normal);
    color: var(--color-ink);
  }

  .institut__body {
    margin-block-start: var(--space-6);
    max-inline-size: 46ch;
    color: var(--color-ink-soft);
  }

  .institut__body p + p {
    margin-block-start: var(--space-4);
  }

  /* ------------------------------------------------------------- Publics
     Plus de fond ni de cadre : un filet et une liste suffisent. */
  .institut__publics {
    margin-block-start: var(--space-7);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-hairline) solid var(--rule-strong);
  }

  .institut__publics-title {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-forest);
    margin-block-end: var(--space-4);
  }

  .institut__publics-list {
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .institut__publics-list li {
    position: relative;
    padding-inline-start: var(--space-5);
    line-height: 1.45;
  }

  .institut__publics-list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.62em;
    inline-size: 10px;
    block-size: 1px;
    background-color: var(--color-accent);
  }

  /* ============================================================ Sommaire */
  .apports {
    border-block-start: var(--border-hairline) solid var(--rule);
  }

  .apport {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: var(--space-3);
    /* Le numéro partage la ligne de base de son titre. C'est la grille qui
       l'aligne, pas un décalage réglé à la main : les deux corps changent
       avec le viewport, un padding en em ne suivrait pas. */
    align-items: baseline;
    padding-block: var(--space-4);
    border-block-end: var(--border-hairline) solid var(--rule);
  }

  /* Le numéro est un élément graphique à part entière : grande serif,
     suspendue dans la marge. */
  .apport__index {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--color-accent-ink);
  }

  .apport__title {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    color: var(--color-navy);
  }

  .apport__text {
    margin-block-start: var(--space-2);
    max-inline-size: var(--measure);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }

  @media (min-width: 62rem) {
    /* Rapport 5/7 : le manifeste est la colonne étroite, le sommaire occupe
       l'espace principal. */
    .institut__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-10);
      align-items: start;
    }

    .institut__intro {
      position: sticky;
      inset-block-start: calc(var(--header-h) + var(--space-6));
    }

    .apport {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      column-gap: var(--space-4);
      padding-block: var(--space-6);
    }

    .apport__index {
      font-size: 2rem;
    }

    .apport__title {
      font-size: 1.5rem;
    }
  }

  /* Le sticky ne doit pas s'activer si la colonne dépasse la hauteur d'écran. */
  @media (min-width: 62rem) and (max-height: 50rem) {
    .institut__intro {
      position: static;
    }
  }
</style>
