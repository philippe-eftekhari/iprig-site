---
/**
 * Pied de page institutionnel.
 *
 * Les liens sociaux viennent de src/data/site.ts via `SocialLinks` : une URL
 * corrigée dans le fichier de données l'est ici aussi. Une plateforme sans URL
 * n'est jamais rendue — aucun lien mort.
 *
 * ⚠ DEUX listes distinctes, deux colonnes distinctes :
 *   — colonne « Rejoindre » : `activeIprigSocialLinks`, comptes de l'INSTITUT ;
 *   — colonne « KevanExplique » : `activeSocialLinks`, comptes de la MARQUE
 *     de contenu de Kevan Gafaïti.
 * Instagram et LinkedIn figurent des deux côtés avec des adresses différentes.
 * Ne jamais les fusionner ni intervertir.
 *
 * ⚠ Aucune adresse e-mail n'est publiée : la page Contact porte un formulaire,
 * dont la destination reste côté serveur.
 */
import Wordmark from './Wordmark.astro';
import SocialLinks from './SocialLinks.astro';
import { mainNav, footerNav } from '../data/navigation';
import { site, offer, legal, activeIprigSocialLinks } from '../data/site';
import { kevanExplique } from '../data/kevan';
---

<footer class="footer">
  <div class="container container--wide">
    <div class="footer__top">
      <div class="footer__brand">
        <Wordmark size="lg" tone="light" />
        <p class="footer__name">{site.fullName}</p>
        <a
          class="btn btn--ghost-on-dark footer__cta"
          href={offer.patreonUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {offer.ctaPrimary}
          <span class="sr-only"> (sur Patreon, nouvelle fenêtre)</span>
        </a>
      </div>

      <div class="footer__cols">
        <nav class="footer__col" aria-label="Pied de page — navigation">
          <h2 class="footer__title">Navigation</h2>
          <ul class="footer__list">
            {
              mainNav.map((item) => (
                <li>
                  <a class="footer__link" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="footer__col">
          <h2 class="footer__title">Rejoindre</h2>
          <ul class="footer__list">
            <li>
              <a
                class="footer__link"
                href={offer.patreonUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Patreon<span class="sr-only"> (nouvelle fenêtre)</span>
              </a>
            </li>
            {/* Deux lignes distinctes : dans une colonne étroite, une seule
                ligne couperait « Sans engagement » en deux. */}
            <li class="footer__meta">
              {offer.priceDisplay} {offer.pricePeriod}
            </li>
            <li class="footer__meta">{offer.commitment}</li>
            <li>
              <a class="footer__link" href="/certificats">Certificats</a>
            </li>
          </ul>

          {/* Comptes officiels de l'IPRIG — pas ceux de KevanExplique, qui
              gardent leur colonne. Mêmes glyphes, même survol, même pas
              vertical que la liste ci-dessus : le bloc la prolonge. */}
          <SocialLinks
            links={activeIprigSocialLinks}
            layout="stack"
            srContext="de l’IPRIG"
            class="footer__socials-iprig"
          />
        </div>

        <div class="footer__col">
          <h2 class="footer__title">Contact</h2>
          <ul class="footer__list">
            <li>
              <a class="footer__link" href="/contact">Écrire à l’IPRIG</a>
            </li>
            <li>
              <a class="footer__link" href="/certificats#preinscription">
                Préinscription aux certificats
              </a>
            </li>
          </ul>
        </div>

        <div class="footer__col">
          <h2 class="footer__title">{kevanExplique.name}</h2>
          <SocialLinks class="footer__socials" />
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">
        © {legal.copyrightYear} {site.name}. Tous droits réservés.
      </p>
      <ul class="footer__legal">
        {
          footerNav.map((item) => (
            <li>
              <a class="footer__link footer__link--sm" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-navy-deep);
    color: var(--color-on-dark-muted);
    padding-block: var(--space-10) var(--space-7);
    font-size: var(--text-sm);
  }

  .footer__top {
    display: grid;
    gap: var(--space-9);
    padding-block-end: var(--space-8);
    border-block-end: var(--border-hairline) solid var(--rule-on-dark);
  }

  .footer__name {
    margin-block-start: var(--space-4);
    max-inline-size: 26ch;
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: 1.35;
    color: var(--color-on-dark);
  }

  .footer__cta {
    margin-block-start: var(--space-5);
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-7) var(--space-5);
  }

  .footer__title {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent-bright);
    margin-block-end: var(--space-4);
  }

  .footer__list {
    display: grid;
    gap: var(--space-2);
  }

  .footer__link {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--color-on-dark);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-ui);
  }

  .footer__link:hover {
    color: var(--color-accent-bright);
  }

  .footer__link--sm {
    color: var(--color-on-dark-muted);
  }

  .footer__meta {
    color: var(--color-on-dark-muted);
  }

  /* Les liens sociaux sont plus serrés que les colonnes de navigation :
     ce sont des glyphes accompagnés d'un mot, pas des entrées de menu. */
  .footer__socials {
    gap: 0 var(--space-4);
    color: var(--color-on-dark);
  }

  /* `footer__socials-iprig` ne porte AUCUNE règle ici, et c'est délibéré.
     Une feuille de style de composant ne descend pas jusqu'à la racine d'un
     composant enfant : la règle `.footer__socials` juste au-dessus est, pour
     la même raison, sans effet depuis toujours — les deux blocs sociaux
     prennent la couleur du pied de page, ce qui est précisément le rendu
     validé. La mise en pile des comptes IPRIG est donc portée par
     `socials--stack`, dans SocialLinks.astro. La classe reste un point
     d'accroche : elle distingue les comptes de l'institut de ceux de
     KevanExplique, pour la QA comme pour un futur ajustement. */

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block-start: var(--space-6);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  @media (min-width: 48rem) {
    .footer__cols {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .footer {
      padding-block: var(--space-11) var(--space-7);
    }

    .footer__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: var(--space-10);
    }
  }
</style>
