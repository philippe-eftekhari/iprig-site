---
/**
 * Pied de page institutionnel.
 * Les liens sociaux dont l’URL vaut `null` sont automatiquement masqués :
 * aucun lien mort, aucun compte inventé.
 */
import Wordmark from './Wordmark.astro';
import { mainNav, footerNav } from '../data/navigation';
import {
  site,
  offer,
  contact,
  legal,
  socialsIprig,
  socialsKevanExplique,
} from '../data/site';

const iprigLinks = socialsIprig.filter((s) => s.url !== null);
const kevanLinks = socialsKevanExplique.filter((s) => s.url !== null);
---

<footer class="footer">
  <div class="container container--wide">
    <div class="footer__top">
      <div class="footer__brand">
        <Wordmark size="lg" tone="light" />
        <p class="footer__name">{site.fullName}</p>
        <a
          class="btn btn--ghost-on-dark footer__cta"
          href={offer.patreonUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {offer.ctaPrimary}
          <span class="sr-only"> (sur Patreon, nouvelle fenêtre)</span>
        </a>
      </div>

      <div class="footer__cols">
        <nav class="footer__col" aria-label="Pied de page — navigation">
          <h2 class="footer__title">Navigation</h2>
          <ul class="footer__list">
            {
              mainNav.map((item) => (
                <li>
                  <a class="footer__link" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="footer__col">
          <h2 class="footer__title">Rejoindre</h2>
          <ul class="footer__list">
            <li>
              <a
                class="footer__link"
                href={offer.patreonUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Patreon<span class="sr-only"> (nouvelle fenêtre)</span>
              </a>
            </li>
            {/* Deux lignes distinctes : dans une colonne étroite, une seule
                ligne couperait « Sans engagement » en deux. */}
            <li class="footer__meta">
              {offer.priceDisplay} {offer.pricePeriod}
            </li>
            <li class="footer__meta">{offer.commitment}</li>
          </ul>
        </div>

        <div class="footer__col">
          <h2 class="footer__title">Contact</h2>
          <ul class="footer__list">
            {
              contact.email && (
                <li>
                  <a class="footer__link" href={`mailto:${contact.email}`}>
                    {contact.email}
                  </a>
                </li>
              )
            }
            {
              iprigLinks.map((s) => (
                <li>
                  <a
                    class="footer__link"
                    href={s.url!}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {s.label}
                    <span class="sr-only"> (nouvelle fenêtre)</span>
                  </a>
                </li>
              ))
            }
            <li>
              <a class="footer__link" href="/contact">Page contact</a>
            </li>
          </ul>
          {
            /* TODO CLIENT : e-mail officiel, Instagram IPRIG, LinkedIn IPRIG.
               Les liens apparaîtront automatiquement une fois renseignés
               dans src/data/site.ts. */
          }
        </div>

        {
          kevanLinks.length > 0 && (
            <div class="footer__col">
              <h2 class="footer__title">Kevan Explique</h2>
              <ul class="footer__list">
                {kevanLinks.map((s) => (
                  <li>
                    <a
                      class="footer__link"
                      href={s.url!}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {s.label}
                      <span class="sr-only"> (nouvelle fenêtre)</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">
        © {legal.copyrightYear} {site.name}. Tous droits réservés.
      </p>
      <ul class="footer__legal">
        {
          footerNav.map((item) => (
            <li>
              <a class="footer__link footer__link--sm" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-navy-deep);
    color: var(--color-on-dark-muted);
    padding-block: var(--space-10) var(--space-7);
    font-size: var(--text-sm);
  }

  .footer__top {
    display: grid;
    gap: var(--space-9);
    padding-block-end: var(--space-8);
    border-block-end: var(--border-hairline) solid var(--rule-on-dark);
  }

  .footer__name {
    margin-block-start: var(--space-4);
    max-inline-size: 26ch;
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: 1.35;
    color: var(--color-on-dark);
  }

  .footer__cta {
    margin-block-start: var(--space-5);
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-7) var(--space-5);
  }

  .footer__title {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent-bright);
    margin-block-end: var(--space-4);
  }

  .footer__list {
    display: grid;
    gap: var(--space-2);
  }

  .footer__link {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--color-on-dark);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-ui);
  }

  .footer__link:hover {
    color: var(--color-accent-bright);
  }

  .footer__link--sm {
    color: var(--color-on-dark-muted);
  }

  .footer__meta {
    color: var(--color-on-dark-muted);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block-start: var(--space-6);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  @media (min-width: 48rem) {
    .footer__cols {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .footer {
      padding-block: var(--space-11) var(--space-7);
    }

    .footer__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: var(--space-10);
    }
  }
</style>
