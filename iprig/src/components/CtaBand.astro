---
/**
 * CTA intermédiaire — bandeau éditorial.
 *
 * Arrive tôt, dès que le visiteur a compris ce qu'est l'IPRIG, ce qu'il
 * apporte et comment il fonctionne.
 *
 * Volontairement COMPACT et HORIZONTAL : c'est une respiration dense au
 * milieu d'une page aérée, pas un second bloc de conversion. Le bloc de
 * clôture (CtaPoster) est l'inverse — vaste et typographique. Les deux ne
 * doivent jamais se ressembler.
 *
 * Prix, mention d'engagement et URL Patreon viennent tous de
 * `src/data/site.ts` : rien n'est écrit en dur ici.
 */
import Arrow from './Arrow.astro';
import { offer } from '../data/site';

interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<section class="band section--forest" id={id}>
  <div class="container container--wide band__inner">
    <h2 class="band__title">{offer.ctaPrimary}</h2>

    <p class="band__price">
      <span class="band__amount">{offer.priceDisplay}</span>
      <span class="band__period">{offer.pricePeriod}</span>
    </p>

    <p class="band__note">
      Une seule formule.<br />
      {offer.commitment}, résiliable à tout moment.
    </p>

    <a
      class="btn btn--on-dark btn--lg band__cta"
      href={offer.patreonUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      {offer.ctaPrimary}
      <Arrow />
      <span class="sr-only"> (sur Patreon, nouvelle fenêtre)</span>
    </a>
  </div>
</section>

<style>
  .band {
    /* Section « compacte » : un des quatre rythmes verticaux du site. */
    padding-block: var(--section-compact);
  }

  .band__inner {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .band__title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.125rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-on-dark);
    max-inline-size: 12ch;
  }

  /* Le prix est traité comme une information éditoriale : grand chiffre,
     unité en petit à côté. Pas de compteur, pas de cadre. */
  .band__price {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .band__amount {
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 2rem + 3.4vw, 4.5rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--color-accent-bright);
  }

  .band__period {
    font-size: var(--text-sm);
    color: var(--color-on-dark-muted);
  }

  .band__note {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-on-dark-muted);
    max-inline-size: 30ch;
  }

  .band__cta {
    /* Sur téléphone, le bouton prend toute la largeur — comme celui du hero
       et celui du tiroir. Trois CTA principaux, trois fois le même geste au
       pouce. Il redevient un bouton de ligne dès que le bandeau s'étale à
       l'horizontale (voir plus bas). */
    justify-self: stretch;
    /* Un libellé de bouton ne se coupe jamais en deux. */
    white-space: nowrap;
  }

  /* Bandeau horizontal dès qu'il y a la place : quatre informations
     alignées sur une seule ligne de lecture. */
  @media (min-width: 62rem) {
    /* Les filets verticaux doivent courir sur toute la hauteur du bandeau,
       pas seulement sur celle du texte : ce sont eux qui en font une
       structure plutôt qu'une ligne d'éléments posés côte à côte.

       Pour cela, le rythme vertical descend de la section vers les blocs.
       C'est le seul moyen sans balise supplémentaire : une bordure ne peut
       s'étendre au-delà de la boîte qui la porte. Le bouton est exclu — un
       `padding-block` sur une balise `a.btn` gonflerait le bouton lui-même. */
    .band {
      padding-block: 0;
    }

    .band__inner {
      grid-template-columns: auto auto minmax(0, 1fr) auto;
      gap: var(--space-8);
      align-items: stretch;
    }

    .band__inner > * {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .band__inner > :not(.band__cta) {
      padding-block: var(--section-compact);
    }

    /* Sélecteur enfant : le scoping Astro donne à `.band__inner > *` une
       spécificité supérieure à une simple classe. */
    .band__inner > .band__price {
      flex-direction: row;
      align-items: baseline;
    }

    .band__title {
      max-inline-size: 9ch;
    }

    /* Filets verticaux entre les blocs : ils tiennent la ligne sans cadre. */
    .band__price,
    .band__note {
      padding-inline-start: var(--space-8);
      border-inline-start: var(--border-hairline) solid var(--rule-on-dark);
    }

    /* Sélecteur enfant, pour la même raison de spécificité que ci-dessus :
       le bouton reste un bouton, ligne unique, sans étirement vertical. */
    .band__inner > .band__cta {
      display: inline-flex;
      flex-direction: row;
      align-items: center;
      align-self: center;
      justify-self: end;
      inline-size: auto;
    }
  }
</style>
