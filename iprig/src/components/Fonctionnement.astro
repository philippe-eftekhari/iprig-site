---
/**
 * « Comment ça marche » — le parcours du membre, en trois étapes.
 * Le site explique le principe sans détailler le fonctionnement technique
 * de Patreon : du point de vue du visiteur, il rejoint, il devient membre,
 * il accède aux contenus et aux opportunités.
 */
import { fonctionnement } from '../data/programme';
---

<div class="fonctionnement">
  <h3 class="fonctionnement__title">Comment cela se passe</h3>
  <ol class="fonctionnement__list">
    {
      fonctionnement.map((e) => (
        <li class="etape">
          <span class="etape__step" aria-hidden="true">
            {e.step}
          </span>
          <h4 class="etape__title">{e.title}</h4>
          <p class="etape__text">{e.text}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .fonctionnement__title {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-muted);
    padding-block-end: var(--space-4);
    border-block-end: var(--border-hairline) solid var(--rule);
    margin-block-end: var(--space-6);
  }

  .fonctionnement__list {
    display: grid;
    gap: var(--space-5);
  }

  .etape {
    position: relative;
    padding-block-start: var(--space-3);
    border-block-start: 2px solid var(--color-forest);
  }

  .etape__step {
    display: block;
    font-family: var(--font-serif);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    color: var(--color-accent-ink);
    margin-block-end: var(--space-2);
  }

  .etape__title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: var(--tracking-tight);
    color: var(--color-navy);
  }

  .etape__text {
    margin-block-start: var(--space-2);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }

  @media (min-width: 48rem) {
    .fonctionnement__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
</style>
