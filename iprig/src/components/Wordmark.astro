---
/**
 * Wordmark IPRIG — logo officiel + sigle composé.
 *
 * V4 : le losange laiton provisoire laisse la place au logo réel fourni par le
 * client (colonne, comète, étoile). Le fichier est masqué en rond et son fond
 * est transparent : il tient donc aussi bien sur le papier de l'en-tête que
 * sur le marine du pied de page et du tiroir mobile, sans seconde version.
 *
 * Le sigle reste composé en Newsreader plutôt que repris du fichier image :
 * une typographie vectorielle reste nette à toutes les tailles, s'aligne sur
 * la grille du site et reste lisible si l'image ne charge pas.
 *
 * Le logo est purement décoratif ici — le mot « IPRIG » juste à côté porte
 * déjà l'information. `alt=""` évite de l'annoncer deux fois.
 */
import { Image } from 'astro:assets';
import mark from '../assets/brand/iprig-mark.png';

interface Props {
  /** Adapte les couleurs au fond. */
  tone?: 'ink' | 'light';
  /** Taille du sigle. */
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { tone = 'ink', size = 'md', class: className = '' } = Astro.props;
---

<span class={`wordmark wordmark--${tone} wordmark--${size} ${className}`}>
  <Image
    class="wordmark__mark"
    src={mark}
    alt=""
    width={64}
    height={64}
    densities={[1, 2]}
    loading="eager"
  />
  <span class="wordmark__type">IPRIG</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.42em;
    font-family: var(--font-serif);
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* La taille du logo suit celle du sigle : une seule valeur à régler.
     1.55em cale la hauteur du rond entre la ligne de base et la hauteur de
     capitale — le logo accompagne le mot, il ne le domine pas. */
  .wordmark__mark {
    inline-size: 1.55em;
    block-size: 1.55em;
    flex: none;
    object-fit: contain;
  }

  .wordmark--ink {
    color: var(--color-navy);
  }

  .wordmark--light {
    color: var(--color-paper);
  }

  .wordmark--sm {
    font-size: 1.0625rem;
  }

  .wordmark--md {
    font-size: 1.3125rem;
  }

  .wordmark--lg {
    font-size: 1.75rem;
  }

  @media (min-width: 48rem) {
    .wordmark--md {
      font-size: 1.4375rem;
    }
  }
</style>
