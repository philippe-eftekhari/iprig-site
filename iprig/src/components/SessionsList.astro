---
/**
 * Liste des séances.
 *
 * Alimentée par `sessions` (src/data/programme.ts) : la page d'accueil et la
 * page /programme affichent donc rigoureusement les mêmes exemples.
 *
 * TODO CLIENT : le programme annuel définitif n'a pas encore été communiqué.
 * Les quatre séances affichées ont été validées comme exemples représentatifs.
 */
import { sessions } from '../data/programme';

interface Props {
  /** Nombre de séances affichées. Sans limite, la liste complète. */
  limit?: number;
}

const { limit } = Astro.props;
const visibles = limit ? sessions.slice(0, limit) : sessions;
---

<div class="sessions">
  <ul class="sessions__list">
    {
      visibles.map((s, i) => (
        <li class="session">
          <span class="session__num" aria-hidden="true">
            {i + 1}
          </span>
          <div class="session__body">
            <h3 class="session__title">{s.title}</h3>
            <p class="session__summary">{s.summary}</p>
          </div>
          <span class="session__cat">{s.category}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* -------------------------------------------------------- Les séances */
  .sessions__list {
    border-block-start: var(--border-hairline) solid var(--rule);
  }

  .session {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    grid-template-areas:
      'num  cat'
      'num  body';
    column-gap: var(--space-4);
    align-items: start;
    padding-block: var(--space-5);
    border-block-end: var(--border-hairline) solid var(--rule);
    transition: background-color var(--dur-fast) var(--ease-ui);
  }

  .session__num {
    grid-area: num;
    font-family: var(--font-serif);
    font-size: 0.8125rem;
    line-height: 1.7;
    letter-spacing: 0.08em;
    color: var(--color-accent-ink);
  }

  .session__body {
    grid-area: body;
  }

  .session__title {
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1.05rem + 0.5vw, 1.375rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: var(--tracking-tight);
    color: var(--color-navy);
    text-wrap: balance;
  }

  .session__summary {
    margin-block-start: var(--space-2);
    max-inline-size: var(--measure);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }

  .session__cat {
    grid-area: cat;
    justify-self: start;
    margin-block-end: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-forest);
  }

  @media (min-width: 48rem) {
    .session {
      grid-template-columns: 2.75rem minmax(0, 1fr) 9rem;
      grid-template-areas: 'num body cat';
      column-gap: var(--space-5);
      padding-block: var(--space-6);
      align-items: baseline;
    }

    .session__cat {
      justify-self: end;
      margin-block-end: 0;
      text-align: end;
    }
  }
</style>
