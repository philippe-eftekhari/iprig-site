---
/**
 * Programme des séances.
 *
 * Alimenté par `sessions` / `semestres` (src/data/programme.ts) : la page
 * d'accueil et la page /programme affichent donc rigoureusement le même
 * programme, et aucun intitulé n'est recopié ici.
 *
 * Deux formes, une seule ligne de séance :
 *   — sans `limit`, le programme complet regroupé par semestre (/programme) ;
 *   — avec `limit`, un extrait à plat des premières séances (accueil).
 *
 * TODO CLIENT : les dates du second semestre ne sont pas encore arrêtées.
 * Elles s'affichent « Date à venir » tant que `date` vaut `null` — voir
 * `DATE_A_VENIR` dans la source de données.
 */
import { sessions, semestres, DATE_A_VENIR } from '../data/programme';

interface Props {
  /**
   * Extrait : nombre de séances affichées, à plat et sans en-tête de
   * semestre. Sans limite, le programme complet par semestre.
   */
  limit?: number;
}

const { limit } = Astro.props;
const extrait = limit ? sessions.slice(0, limit) : null;

/**
 * Les deux formes se ramènent à la même structure, pour que le gabarit d'une
 * séance n'existe qu'une fois.
 */
const blocs = extrait
  ? [{ label: null, attente: false, seances: extrait }]
  : semestres.map((s) => ({
      label: s.label,
      /* La note d'attente se déduit des dates : elle disparaîtra d'elle-même
         quand les `null` du second semestre auront été remplis. */
      attente: s.sessions.some((x) => x.date === null),
      seances: s.sessions,
    }));

/* Un extrait est une liste de premier niveau : ses intitulés restent en h3.
   Regroupé, le semestre prend le h3 et les intitulés descendent en h4. */
const Titre = extrait ? 'h3' : 'h4';
---

<div class="sessions">
  {
    blocs.map((bloc) => (
      <section class="semestre">
        {bloc.label && (
          <div class="semestre__head">
            <h3 class="semestre__title">{bloc.label}</h3>
            <p class="semestre__meta">{bloc.seances.length} séances</p>
            {bloc.attente && (
              <p class="semestre__note">
                Les dates seront communiquées ultérieurement.
              </p>
            )}
          </div>
        )}

        <ol class="sessions__list" role="list" start={bloc.seances[0].number}>
          {bloc.seances.map((s) => (
            <li class="session">
              <span class="session__num" aria-hidden="true">
                {s.number}
              </span>
              <p class="session__date">{s.date ?? DATE_A_VENIR}</p>
              <div class="session__body">
                <Titre class="session__title">{s.title}</Titre>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  /* ------------------------------------------------------- Les semestres */
  .semestre + .semestre {
    margin-block-start: var(--space-8);
  }

  .semestre__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin-block-end: var(--space-4);
  }

  .semestre__title {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    color: var(--color-navy);
  }

  .semestre__meta {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* La note prend la ligne entière : elle explique, elle n'étiquette pas.
     Traitement sobre — pas de bandeau, pas d'encadré, pas de couleur d'alerte. */
  .semestre__note {
    flex-basis: 100%;
    max-inline-size: var(--measure);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-muted);
  }

  /* -------------------------------------------------------- Les séances */
  .sessions__list {
    border-block-start: var(--border-hairline) solid var(--rule);
  }

  .session {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    grid-template-areas:
      'num  date'
      'num  body';
    column-gap: var(--space-4);
    align-items: start;
    padding-block: var(--space-5);
    border-block-end: var(--border-hairline) solid var(--rule);
    transition: background-color var(--dur-fast) var(--ease-ui);
  }

  .session__num {
    grid-area: num;
    font-family: var(--font-serif);
    font-size: 0.8125rem;
    line-height: 1.7;
    letter-spacing: 0.08em;
    color: var(--color-accent-ink);
    font-variant-numeric: tabular-nums;
  }

  .session__body {
    grid-area: body;
  }

  .session__title {
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1.05rem + 0.5vw, 1.375rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: var(--tracking-tight);
    color: var(--color-navy);
    text-wrap: balance;
  }

  /* La date occupe la place que tenait l'étiquette de famille : même colonne,
     même poids. Elle n'est PAS en capitales — une date en capitales se lit
     mal et prendrait une demi-colonne de plus.

     La colonne de bureau vaut 11,5 rem : « Dimanche 22 novembre 2026 » mesure
     169 px, et 10,5 rem (168 px) la coupait en deux lignes. Le repli reste
     autorisé — une date plus longue vaudra mieux sur deux lignes équilibrées
     qu'en débordement. */
  .session__date {
    grid-area: date;
    justify-self: start;
    margin-block-end: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-forest);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 48rem) {
    .session {
      grid-template-columns: 2.75rem minmax(0, 1fr) 11.5rem;
      grid-template-areas: 'num body date';
      column-gap: var(--space-5);
      padding-block: var(--space-6);
      align-items: baseline;
    }

    .session__date {
      justify-self: end;
      margin-block-end: 0;
      text-align: end;
      text-wrap: balance;
    }
  }
</style>
