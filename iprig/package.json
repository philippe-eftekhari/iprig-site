{
  "name": "iprig-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Site officiel de l'IPRIG — Institut de preparation aux relations internationales et a la geopolitique",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "build:fast": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "og": "node scripts/build-og-image.mjs",
    "qa:screens": "node scripts/qa-screenshots.mjs http://localhost:4321",
    "qa:tests": "node scripts/qa-functional.mjs http://localhost:4321",
    "qa:perf": "node scripts/qa-perf.mjs http://localhost:4321",
    "qa:header": "node scripts/qa-header.mjs http://localhost:4321",
    "qa": "node scripts/qa-functional.mjs http://localhost:4321 && node scripts/qa-screenshots.mjs http://localhost:4321 && node scripts/qa-perf.mjs http://localhost:4321",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^7.2.6",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
